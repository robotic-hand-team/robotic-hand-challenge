# ==============================================================================
# APPLICATION ENVIRONMENT & LOGGING
# ==============================================================================
# Options: development, staging, production
ENVIRONMENT=development
# Options: debug, info, warning, error, critical
LOG_LEVEL=info

# ==============================================================================
# API BACKEND CONFIGURATION
# ==============================================================================
API_HOST=0.0.0.0
API_PORT=8000
# SECURITY WARNING: Generate a secure random string for production deployment!
API_SECRET_KEY=super_secret_key_change_me_before_deploying

# ==============================================================================
# HARDWARE & MODBUS TCP CONFIGURATION (Inspire RH56DFTP)
# ==============================================================================
# Target IP: Physical controller network or local Docker network alias ('emulator')
MODBUS_HOST=192.168.11.210
MODBUS_PORT=6000
# Socket timeout in seconds (prevents blocking worker threads if hardware hangs)
MODBUS_TIMEOUT=2.0
MODBUS_RETRY_ATTEMPTS=3

# ==============================================================================
# SIMULATION & EMULATOR SETTINGS
# ==============================================================================
# Toggle: Set to 'false' when switching from the MuJoCo emulator to physical hardware
EMULATOR_ENABLED=true
EMULATOR_PORT=6000
SIMULATION_HZ=100

# ==============================================================================
# FRONTEND CONFIGURATION (Vite / React)
# ==============================================================================
# Public API base URL injected at build/runtime for the web dashboard
VITE_API_BASE_URL=http://localhost:8000