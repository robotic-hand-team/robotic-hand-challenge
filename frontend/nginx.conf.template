# Rendered to /etc/nginx/conf.d/default.conf by the nginx image; only ${BACKEND_ADDR} is substituted
# (variables that are not set in the environment, like $host, are left alone).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 3000;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json model/gltf-binary model/gltf+json;

    # Backend API, including the /api/live WebSocket.
    location /api/ {
        proxy_pass http://${BACKEND_ADDR};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 1h;   # the live socket stays open
    }

    # Hashed build assets never change; index.html must not be cached.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
